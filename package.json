{
  "name": "mqttpc",
  "version": "2.0.1",
  "description": "Control processes on a host via MQTT. Follows the mqtt-smarthome architecture.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "mqttpc": "index.js"
  },
  "preferGlobal": true,
  "files": [
    "index.js",
    "config.js",
    "lib/",
    "example-procs.json",
    "procs.schema.json"
  ],
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test",
    "deploy": "bash deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/mqttpc.git"
  },
  "homepage": "https://github.com/hobbyquaker/mqttpc",
  "bugs": {
    "url": "https://github.com/hobbyquaker/mqttpc/issues"
  },
  "author": "Sebastian Raff <hobbyquaker@gmail.com> (https://github.com/hobbyquaker)",
  "license": "MIT",
  "keywords": [
    "mqtt",
    "mqtt-smarthome",
    "home-automation",
    "process",
    "controller",
    "spawn",
    "shell",
    "command",
    "stdin",
    "stdout"
  ],
  "mqttInterfaces": {
    "spec": "2.0",
    "envPrefix": "MQTTPC",
    "needs": [],
    "serviceExtra": []
  },
  "dependencies": {
    "mqtt-interfaces-core": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3"
  }
}
